# Auth uses only a publishable key. No service-role / secret keys in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A dedicated famfi_app LOGIN role, never postgres. Production only on Vercel.
DATABASE_URL=
# Email allowlist for requesting sign-in codes; DB membership is authoritative.
FAMFI_ALLOWED_EMAIL=
APP_ORIGIN=http://localhost:3000
